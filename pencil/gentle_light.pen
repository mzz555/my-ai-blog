            },
            {
              "type": "frame",
              "id": "QInLW",
              "layoutPosition": "absolute",
              "x": 360,
              "y": 950,
              "name": "articleBody",
              "width": 720,
              "layout": "vertical",
              "gap": 40,
              "children": [
                {
                  "type": "text",
                  "id": "xK0Q1",
                  "fill": "$text_secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Server Components are a new paradigm in React that allows you to render components exclusively on the server. This fundamental shift brings massive performance improvements and a simplified data-fetching mental model.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "BXCPt",
                  "fill": "$text_primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Why Server Components?",
                  "fontFamily": "Inter",
                  "fontSize": 32,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "afztJ",
                  "fill": "$text_secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Historically, React was purely a client-side library. As applications grew, developers had to ship increasingly large JavaScript bundles to the browser. Server Components solve this by keeping heavy dependencies on the server.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "AFR9Y",
                  "name": "quote",
                  "width": "fill_container",
                  "stroke": {
                    "thickness": {
                      "left": 4
                    },
                    "fill": "$accent"
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    0,
                    0,
                    0,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "cTxZf",
                      "fill": "$text_primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"The beauty of Server Components is that they allow you to write database queries right next to your UI code without ever exposing your secrets to the client.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "500",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "oU1UO",
                  "fill": "$text_primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A simple example",
                  "fontFamily": "Inter",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "frame",
                  "id": "SMVtd",
                  "name": "codeBlock",
                  "width": "fill_container",
                  "fill": "#09090B",
                  "cornerRadius": "$radius_md",
                  "stroke": {
                    "thickness": 1,
                    "fill": "$border"
                  },
                  "layout": "vertical",
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "pKfkM",
                      "fill": "#A1A1AA",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "export default async function ProductPage({ id }) {\n  // This query runs securely on the server\n  const product = await db.product.findUnique({ id });\n\n  return (\n    <main>\n      <h1>{product.name}</h1>\n      <BuyButton id={product.id} />\n    </main>\n  );\n}",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "XLQG1",
                  "fill": "$text_secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "By default, all components inside the App Router in Next.js are Server Components. If you need interactivity (like `onClick` handlers or `useState`), you explicitly mark a component with the `\"use client\"` directive at the top of the file.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
