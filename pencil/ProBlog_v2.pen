                  "type": "text",
                  "id": "XLQG1",
                  "fill": "$text_secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "By default, all components inside the App Router in Next.js are Server Components. If you need interactivity (like `onClick` handlers or `useState`), you explicitly mark a component with the `\"use client\"` directive at the top of the file.",
                  "lineHeight": 1.7,
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
